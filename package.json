{
  "name": "dsh-crawshrimp-data",
  "version": "0.2.0",
  "description": "Independent CSV and XLSX tools for DeepSeek Harness; no Crawshrimp backend",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/tables.js && node --check lib/transform.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.4 <0.2.1-alpha.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/howtimeschange/dsh-crawshrimp-data.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "crawshrimp",
    "ecommerce",
    "data"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2",
    "exceljs": "^4.4.0",
    "adm-zip": "^0.6.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.4"
  }
}
